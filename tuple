using System;
using System.Collections.Generic;
using System.Linq;
using System.Web;
using System.Web.UI;
using System.Web.UI.WebControls;

namespace WebApplication14
{
    public partial class WebForm5 : System.Web.UI.Page
    {
        private List<Tuple<string, string, string>> people
        {
            get {
                if (ViewState["people"]==null)
                    ViewState["people"] = new List<Tuple<string, string, string>>();
                return (List<Tuple<string, string, string>>)ViewState["people"];
            } 
            set {
                ViewState["people"] = value;
            }
        }
        protected void Page_Load(object sender, EventArgs e)
        {

        }

        protected void btnans_Click(object sender, EventArgs e)
        {
            //read values
            string name = txtname.Text;
            string age = txtage.Text;
            string email=txtmail.Text;

            //create tuple and add to list
            var person=Tuple.Create(name, age, email);
            people.Add(person);

            //clear input boxes
            txtname.Text = "";
            txtage.Text = "";
            txtmail.Text = "";

            //disply all entries
            display();
        }

        private void display()
        {
            string result = "<b>All Entries</b>";
            foreach (var p in people)
            {
                result += "<br> Name : " + p.Item1 + " | Age : " + p.Item2 + " | Email : " + p.Item3;
            }
            lblshow.Text = result;
        }
    }
}
