        public class vehical
        {
            public string type, name;

            public vehical() { }
            public vehical(string type,string name) 
            {
                this.type = type;
                this.name = name;
            }

            public string Display()
            {
                return type + " " + name;
            }
        }

        public class car : vehical
        {
            public string name,model;
            public int year;
            public double price;

            public car() { }
            public car(string n, string m,int yr,double pr)
            {
                this.name =n; 
                this.model = m;
                this.year = yr;
                this.price = pr;
            }

            public string Display()
            {
                string ans= "Name : " + name + " Model : " + model + " Year : " + year + " Price : " + price;
                return ans;
            }
        }
